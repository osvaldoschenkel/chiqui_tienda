APP_NAME="Chiqui Tienda"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=America/Argentina/Buenos_Aires
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CAMBIAR_BASE
DB_USERNAME=CAMBIAR_USUARIO
DB_PASSWORD="CAMBIAR_PASSWORD"
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
ARCA_ENVIRONMENT=homologation
COMMERCE_COD_ENABLED=false
COMMERCE_COD_DELIVERY_ENABLED=false
# Configurar los secretos desde /integraciones; se guardan cifrados.
